@startuml
left to right direction
actor Cliente
actor Empresa
actor Banco
actor "Agente autorizado" as Agente
Empresa --|> Agente
Banco --|> Agente
rectangle "Vélora" {
  usecase "Cadastrar conta" as Cadastro
  usecase "Entrar com usuário e senha" as Login
  usecase "Gerenciar próprio cadastro\ne empregadores" as Perfil
  usecase "Consultar automóveis" as Catalogo
  usecase "Gerenciar frota" as Frota
  usecase "Criar, consultar, editar ou\ncancelar próprios pedidos" as Pedidos
  usecase "Consultar e editar pedidos" as Gestao
  usecase "Registrar parecer financeiro" as Avaliacao
  usecase "Formalizar e consultar contrato\ne registrar propriedade" as Contrato
  usecase "Vincular contrato de crédito" as Credito
}
Cliente -- Cadastro
Cliente -- Login
Cliente -- Perfil
Cliente -- Catalogo
Cliente -- Pedidos
Empresa -- Frota
Agente -- Login
Agente -- Gestao
Agente -- Avaliacao
Agente -- Contrato
Banco -- Credito
@enduml
