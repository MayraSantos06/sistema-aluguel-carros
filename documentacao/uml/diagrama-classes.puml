@startuml
hide empty members
class Usuario {
  id: Long
  login: String
  senhaHash: String
  perfil: PerfilUsuario
}
enum PerfilUsuario {
  CLIENTE
  EMPRESA
  BANCO
}
class Cliente {
  id: Long
  rg: String
  cpf: String
  nome: String
  endereco: String
  profissao: String
}
class Empregador <<embutido>> {
  nome: String
  rendimento: BigDecimal
}
class Automovel {
  id: Long
  matricula: String
  ano: Integer
  marca: String
  modelo: String
  placa: String
}
class Aluguel {
  id: Long
  dataPedido: LocalDate
  dataInicio: LocalDate
  dataFim: LocalDate
  status: StatusAluguel
  dataParecer: LocalDate
  agenteParecer: String
  observacaoParecer: String
  dataContrato: LocalDate
  agenteContrato: String
  tipoProprietario: PerfilUsuario
  proprietario: String
  valorCredito: BigDecimal
  dataCredito: LocalDate
  bancoCredito: String
}
enum StatusAluguel {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}
Usuario --> PerfilUsuario
Usuario "0..1" --> "0..1" Cliente : cadastro
Cliente "1" *-- "0..3" Empregador
Cliente "1" -- "0..*" Aluguel : solicita
Aluguel "0..*" --> "1" Automovel
Aluguel --> StatusAluguel
Aluguel --> PerfilUsuario : tipo de proprietário
note right of Aluguel
  Parecer, contrato e crédito são opcionais.
  O status registra a decisão do parecer.
  O crédito é registrado por um usuário BANCO.
end note
@enduml
