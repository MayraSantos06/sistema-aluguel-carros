@startuml
left to right direction
package "Frontend · React + Vite" {
  [Telas e navegação\nApp.tsx] as App
  package "components" as Components {
    [Calendário de reservas]
  }
  package "services" as FrontServices
}
package "Backend · Spring MVC" {
  package "config" as Config
  package "controller" as Controller
  package "service" as Service
  package "repository" as Repository
  package "model" as Model
  package "dto" as DTO
}
database "Supabase · PostgreSQL" as DB
App ..> Components : apresenta
App ..> FrontServices : consulta e autenticação
Components ..> FrontServices : tipos e regras de períodos
FrontServices ..> Controller : REST
Config ..> Controller : protege as rotas
Config ..> Service : carrega os usuários
Controller ..> DTO
Controller ..> Service
Service ..> Repository
Service ..> Model
Repository ..> Model
Repository ..> DB : JPA
@enduml
